# code done by sonal: merge into frontend/.env.local (server-only, never NEXT_PUBLIC).
CHATBOT_BACKEND_URL=http://127.0.0.1:5000/chatbot
# Same cryptographically random value as backend; at least 32 characters.
CHATBOT_PROXY_SECRET=
# Set true only if your trusted ingress overwrites x-forwarded-for.
CHATBOT_TRUST_CLIENT_IP=false
